/*
 * Cyboard Imprint Wireless — ZMK keymap
 * Generated from cyboard_wired.vil (Vial JSON export, version 1)
 *
 * ── Physical layout (binding order) ───────────────────────────────
 * 70 keys, interleaved LEFT-then-RIGHT within each row:
 *   Num   [ 0– 5 L | 6–11  R]:  L: GRAVE 1 2 3 4 5     R: 6 7 8 9 0 -
 *   Top   [12–17 L | 18–23 R]:  L: TAB Q W E R T       R: Y U I O P \
 *   Home  [24–29 L | 30–35 R]:  L: CAPS A(HRM) S(HRM) D(HRM) F(HRM) G   R: H J(HRM) K(HRM) L(HRM) ;(HRM) '
 *   Bot   [36–41 L | 42–47 R]:  L: CapsWd Z X C V B    R: N M , . / —
 *   Innr  [48–52 L | 53–57 R]:  outer corners (48 & 57) = td_boot
 *   ThmA  [58–60 L | 61–63 R]:  top thumb row
 *   ThmB  [64–69]:  bottom thumb row — 66 = &mo 7 (Media), 67 = &mo 6 (RGB)
 *
 * ── Layers ───────────────────────────────────────────────────────
 *   0 BASE  1 NAV  2 SYM  3 FN/NUM  4 MOUSE  5 APP  6 RGB  7 MEDIA
 *
 * ── Macros ───────────────────────────────────────────────────────
 *   m0 = ":="   m1 = "!="   m2 = ">="   m3 = "<="
 *   m4 = LG(K)+LG(C)  (VSCode comment block)
 *   m5 = LG(K)+LG(U)  (VSCode uncomment block)
 *
 * ── Combos ───────────────────────────────────────────────────────
 *   R(16) + U(19)      → m1  "!="
 *   G(29) + H(30)      → m0  ":="
 *   V(40) + M(43)      → m2  ">="
 *   ,(44) + C(39)      → m3  "<="
 *
 * ── Home-row mods ────────────────────────────────────────────────
 *   Left : CAPS | A=LSHFT | S=LALT | D=LCTRL | F=LGUI | G
 *   Right: H    | J=RGUI  | K=RCTRL| L=RALT  | ;=RSHFT| '
 *   flavor=balanced, tapping-term=175ms, quick-tap=270ms (from Vial settings 4 & 7)
 *
 * ── Vial timing settings used ────────────────────────────────────
 *   setting  2 = 50   → tap_code delay
 *   setting  4 = 175  → tapping_term_ms
 *   setting  7 = 270  → quick_tap_ms
 *   setting 10 = 50   → combo timeout
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/ {
    /* Matrix transform selected by the stock keymap — this is the key-position
     * order the bindings below (thumbs included) are written against. */
    chosen { zmk,matrix-transform = &imprint_number_row_full_bottom_row; };

    /* ═══════════════════════════════════════════════════════
     *  MACROS
     * ═══════════════════════════════════════════════════════ */
    macros {
        /* m0 — type ":=" */
        m0: macro_assign {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp COLON &kp EQUAL>;
        };

        /* m1 — type "!=" */
        m1: macro_neq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp EXCL &kp EQUAL>;
        };

        /* m2 — type ">=" */
        m2: macro_gte {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp GT &kp EQUAL>;
        };

        /* m3 — type "<=" */
        m3: macro_lte {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp LT &kp EQUAL>;
        };

        /* m4 — LG(K) then LG(C)  (VSCode: comment selected lines) */
        m4: macro_vsc_comment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <10>;
            bindings = <&kp LG(K) &kp LG(C)>;
        };

        /* m5 — LG(K) then LG(U)  (VSCode: uncomment selected lines) */
        m5: macro_vsc_uncomment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <10>;
            bindings = <&kp LG(K) &kp LG(U)>;
        };
    };

    /* ═══════════════════════════════════════════════════════
     *  COMBOS  (timeout 50 ms from Vial setting 10)
     * ═══════════════════════════════════════════════════════ */
    combos {
        compatible = "zmk,combos";

        /* R(pos 16) + U(pos 19) → "!=" */
        combo_neq {
            timeout-ms = <50>;
            key-positions = <16 19>;
            bindings = <&m1>;
        };

        /* G(pos 29) + H(pos 30) → ":=" */
        combo_assign {
            timeout-ms = <50>;
            key-positions = <29 30>;
            bindings = <&m0>;
        };

        /* V(pos 40) + M(pos 43) → ">=" */
        combo_gte {
            timeout-ms = <50>;
            key-positions = <40 43>;
            bindings = <&m2>;
        };

        /* ,(pos 44) + C(pos 39) → "<=" */
        combo_lte {
            timeout-ms = <50>;
            key-positions = <44 39>;
            bindings = <&m3>;
        };
    };

    /* ═══════════════════════════════════════════════════════
     *  BEHAVIORS — balanced home-row mod-tap
     * ═══════════════════════════════════════════════════════ */
    behaviors {
        hm: homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <175>;
            quick-tap-ms = <270>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        /* Bottom-outer corner on each half (inner-row outermost key:
         * position 48 on the left, position 57 on the right — the left one
         * is the TD(0) key on the wired board). 1 tap = nothing, 2 taps =
         * bootloader. &bootloader is source-aware, so each corner resets its
         * own half. tapping-term 200ms matches the Vial tap-dance term. */
        td_boot: tap_dance_bootloader {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&bootloader>;
        };
    };

    /* ═══════════════════════════════════════════════════════
     *  KEYMAP
     *
     *  Binding order per layer (70 keys):
     *    Left  half: Num(6) Top(6) Home(6) Bot(6) Innr(5) Thumb(6)
     *    Right half: Num(6) Top(6) Home(6) Bot(6) Innr(5) Thumb(6)
     * ═══════════════════════════════════════════════════════ */
    keymap {
        compatible = "zmk,keymap";

        /* ── 0: Base ──────────────────────────────────────── */
        base_layer {
            display-name = "Base";
            bindings = <
/* Num  L */  &kp GRAVE        &kp N1           &kp N2           &kp N3           &kp N4           &kp N5
/* Num  R */  &kp N6           &kp N7           &kp N8           &kp N9           &kp N0           &kp MINUS
/* Top  L */  &kp TAB          &kp Q            &kp W            &kp E            &kp R            &kp T
/* Top  R */  &kp Y            &kp U            &kp I            &kp O            &kp P            &kp BSLH
/* Home L */  &kp CAPS         &hm LSHFT A      &hm LALT S       &hm LCTRL D      &hm LGUI F       &kp G
/* Home R */  &kp H            &hm RGUI J       &hm RCTRL K      &hm RALT L       &hm RSHFT SEMI   &kp SQT
/* Bot  L */  &caps_word       &kp Z            &kp X            &kp C            &kp V            &kp B
/* Bot  R */  &kp N            &kp M            &kp COMMA        &kp DOT          &kp FSLH         &none
/* Innr L */  &td_boot         &kp LS(LG(LBKT)) &kp LC(GRAVE)    &kp LG(GRAVE)    &kp LC(LEFT)
/* Innr R */  &kp RC(RIGHT)    &kp RC(UP)       &kp LC(LS(GRAVE)) &kp LS(LG(RBKT)) &td_boot
/* ThmA  L|R */  &lt 1 ESC             &lt 5 DEL             &kp LC(LG(Q))           &kp LS(LC(LA(LG(C)))) &lt 5 TAB             &lt 4 RET
/* ThmB  L|R */  &lt 2 BSPC            &lt 8 LS(LG(A))       &mo 7                   &mo 6                 &lt 8 TAB             &lt 2 SPACE
            >;
        };

        /* ── 1: Nav ───────────────────────────────────────── */
        nav_layer {
            display-name = "Nav";
            bindings = <
/* Num  L */  &trans           &trans           &trans           &trans           &trans           &trans
/* Num  R */  &trans           &trans           &trans           &trans           &trans           &trans
/* Top  L */  &kp LG(Y)        &kp LG(Z)        &kp LG(X)        &kp LG(C)        &kp LG(V)        &kp LS(LG(V))
/* Top  R */  &none            &kp LG(UP)       &kp LA(UP)       &kp RA(DOWN)     &kp RG(DOWN)     &none
/* Home L */  &none            &kp LA(RIGHT)    &kp LG(LEFT)     &kp LG(RIGHT)    &kp LA(LEFT)     &kp LG(BSPC)
/* Home R */  &kp RG(LEFT)     &kp LEFT         &kp UP           &kp DOWN         &kp RIGHT        &kp RG(RIGHT)
/* Bot  L */  &none            &kp LA(BSPC)     &kp LG(BSPC)     &kp LC(K)        &kp LA(DEL)      &none
/* Bot  R */  &none            &kp LA(LEFT)     &kp RG(LEFT)     &kp RG(RIGHT)    &kp RA(RIGHT)    &none
/* Innr L */  &trans           &trans           &trans           &trans           &trans
/* Innr R */  &trans           &trans           &trans           &trans           &trans
/* ThmA  L|R */  &lt 2 DEL             &lt 5 ESC             &trans                  &trans                &mo 5                 &lt 4 RET
/* ThmB  L|R */  &lt 1 BSPC            &trans                &trans                  &trans                &lt 4 TAB             &lt 1 SPACE
            >;
        };

        /* ── 2: Sym ───────────────────────────────────────── */
        sym_layer {
            display-name = "Sym";
            bindings = <
/* Num  L */  &kp GRAVE        &kp LS(N1)       &kp LS(N2)       &kp LS(N3)       &kp LS(N4)       &kp LS(N5)
/* Num  R */  &none            &kp LS(N7)       &kp LS(N8)       &none            &none            &none
/* Top  L */  &kp LS(GRAVE)    &kp LS(N9)       &kp LS(LBKT)     &kp LS(RBKT)     &kp LS(N0)       &kp KP_PLUS
/* Top  R */  &none            &none            &none            &none            &none            &none
/* Home L */  &kp LS(N6)       &kp EQUAL        &kp SQT          &kp LS(SQT)      &kp LS(MINUS)    &kp KP_MULTIPLY
/* Home R */  &none            &kp RGUI         &kp RSHFT        &kp RALT         &kp RCTRL        &none
/* Bot  L */  &kp LS(FSLH)     &kp LS(COMMA)    &kp LBKT         &kp RBKT         &kp LS(DOT)      &kp KP_MINUS
/* Bot  R */  &none            &none            &none            &none            &none            &none
/* Innr L */  &kp LS(N7)       &kp LS(BSLH)     &kp COMMA        &kp LS(FSLH)     &kp KP_DIVIDE
/* Innr R */  &none            &none            &none            &none            &none
/* ThmA  L|R */  &lt 2 DEL             &lt 5 ESC             &none                   &trans                &trans                &lt 2 RET
/* ThmB  L|R */  &lt 1 BSPC            &kp KP_DOT            &trans                  &trans                &lt 4 DEL             &lt 1 SPACE
            >;
        };

        /* ── 3: FN / Numpad ───────────────────────────────── */
        fn_layer {
            display-name = "FN";
            bindings = <
/* Num  L */  &kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &kp F6
/* Num  R */  &kp F7           &kp F8           &kp F9           &kp F10          &kp F11          &kp F12
/* Top  L */  &none            &none            &none            &none            &none            &none
/* Top  R */  &none            &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_DIVIDE    &none
/* Home L */  &none            &none            &none            &none            &none            &none
/* Home R */  &none            &kp KP_N4        &kp KP_N5        &kp KP_N6        &kp KP_MULTIPLY  &none
/* Bot  L */  &none            &none            &none            &none            &none            &none
/* Bot  R */  &none            &kp KP_N1        &kp KP_N2        &kp KP_N3        &kp KP_MINUS     &none
/* Innr L */  &none            &none            &none            &none            &none
/* Innr R */  &kp KP_N0        &kp KP_DOT       &kp KP_EQUAL     &kp KP_PLUS      &none
/* ThmA  L|R */  &lt 2 SPACE           &lt 5 ESC             &trans                  &trans                &trans                &lt 2 RET
/* ThmB  L|R */  &lt 1 BSPC            &trans                &trans                  &trans                &lt 4 DEL             &lt 3 TAB
            >;
        };

        /* ── 4: Mouse ─────────────────────────────────────── */
        mouse_layer {
            display-name = "Mouse";
            bindings = <
/* Num  L */  &none            &none            &none            &none            &none            &none
/* Num  R */  &none            &none            &none            &none            &none            &none
/* Top  L */  &none            &none            &none            &none            &none            &none
/* Top  R */  &none            &none            &none            &none            &none            &none
/* Home L */  &none            &mkp MB4         &mkp MB3         &mkp MB2         &mkp MB1         &none
/* Home R */  &none            &none            &none            &none            &none            &none
/* Bot  L */  &none            &none            &none            &none            &none            &none
/* Bot  R */  &none            &none            &none            &none            &none            &none
/* Innr L */  &none            &none            &none            &none            &none
/* Innr R */  &none            &none            &none            &none            &none
/* ThmA  L|R */  &lt 2 SPACE           &lt 5 ESC             &trans                  &trans                &mo 3                 &lt 4 RET
/* ThmB  L|R */  &lt 1 BSPC            &trans                &trans                  &trans                &lt 4 DEL             &lt 1 TAB
            >;
        };

        /* ── 5: App (application shortcuts) ──────────────── */
        app_layer {
            display-name = "App";
            bindings = <
/* Num  L */  &trans           &trans           &trans           &trans           &trans           &trans
/* Num  R */  &trans           &trans           &trans           &trans           &trans           &trans
/* Top  L */  &trans           &kp LG(S)        &kp LG(W)        &kp LC(LS(T))    &kp LG(KP_DIVIDE) &kp LS(LA(F))
/* Top  R */  &kp LC(F)        &kp LG(H)        &kp RG(P)        &kp LS(LG(O))    &kp LS(LG(P))    &none
/* Home L */  &trans           &kp LG(X)        &kp LG(C)        &kp LG(V)        &kp LG(Z)        &kp LC(LS(Z))
/* Home R */  &kp F12          &kp LA(LEFT)     &kp LA(RIGHT)    &kp RS(F12)      &kp LG(GRAVE)    &trans
/* Bot  L */  &trans           &trans           &m4              &m5              &trans           &trans
/* Bot  R */  &trans           &trans           &trans           &trans           &trans           &trans
/* Innr L */  &trans           &trans           &trans           &trans           &trans
/* Innr R */  &trans           &trans           &trans           &trans           &trans
/* ThmA  L|R */  &lt 2 SPACE           &lt 5 ESC             &trans                  &trans                &trans                &lt 1 RET
/* ThmB  L|R */  &lt 1 BSPC            &trans                &trans                  &trans                &lt 4 DEL             &lt 3 TAB
            >;
        };

        /* ── 6: RGB ──────────────────────────────────────────────
         * Held via &mo 6 on the right thumb cluster's unassigned key
         * (hold to use this layer, release to leave).
         * All controls are on the LEFT hand:
         *   Top row:    Q=toggle on/off   W=next effect   E=prev effect
         *   Home row (increase):  A=hue+   S=sat+   D=bright+   F=speed+
         *   Bottom row (decrease):Z=hue-   X=sat-   C=bright-   V=speed-
         * Columns line up: A/Z=Hue  S/X=Saturation  D/C=Brightness  F/V=Speed */
        rgb_layer {
            display-name = "RGB";
            bindings = <
/* Num  L */  &trans           &trans           &trans           &trans           &trans           &trans
/* Num  R */  &trans           &trans           &trans           &trans           &trans           &trans
/* Top  L */  &trans           &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &trans           &trans
/* Top  R */  &trans           &trans           &trans           &trans           &trans           &trans
/* Home L */  &trans           &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &trans
/* Home R */  &trans           &trans           &trans           &trans           &trans           &trans
/* Bot  L */  &trans           &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &trans
/* Bot  R */  &trans           &trans           &trans           &trans           &trans           &trans
/* Innr L */  &trans           &trans           &trans           &trans           &trans
/* Innr R */  &trans           &trans           &trans           &trans           &trans
/* ThmA  L|R */  &trans                &trans                &trans                  &trans                &trans                &trans
/* ThmB  L|R */  &trans                &trans                &trans                  &trans                &trans                &trans
            >;
        };

        /* ── 7: Media (momentary — hold the empty left-thumb key) ──
         * Controls sit on the RIGHT hand so they're reachable while the
         * left thumb holds the layer:
         *   Home row:  J=play/pause   K=vol−   L=vol+   ;=mute
         *   Top row:   U=prev track   I=next track   O=bright−   P=bright+ */
        media_layer {
            display-name = "Media";
            bindings = <
/* Num  L */  &trans           &trans           &trans           &trans           &trans           &trans
/* Num  R */  &trans           &trans           &trans           &trans           &trans           &trans
/* Top  L */  &trans           &trans           &trans           &trans           &trans           &trans
/* Top  R */  &trans           &kp C_PREV       &kp C_NEXT       &kp C_BRI_DN     &kp C_BRI_UP     &trans
/* Home L */  &trans           &trans           &trans           &trans           &trans           &trans
/* Home R */  &trans           &kp C_PP         &kp C_VOL_DN     &kp C_VOL_UP     &kp C_MUTE       &trans
/* Bot  L */  &trans           &trans           &trans           &trans           &trans           &trans
/* Bot  R */  &trans           &trans           &trans           &trans           &trans           &trans
/* Innr L */  &trans           &trans           &trans           &trans           &trans
/* Innr R */  &trans           &trans           &trans           &trans           &trans
/* ThmA  L|R */  &trans                &trans                &trans                  &trans                &trans                &trans
/* ThmB  L|R */  &trans                &trans                &trans                  &trans                &trans                &trans
            >;
        };

        /* ── 8: WM (window / desktop / tab / terminal navigation) ──
         * The heavily-used inner-row keys, cloned onto the home row and
         * reached by holding a middle thumb-bottom key (either hand).
         * Hold the thumb opposite the hand you want to use:
         *   Left  home (A S D F): MissionCtl  SwitchWin  Desktop<-  Desktop->
         *   Right home (J K L ;): PrevTab  NextTab  ToggleTerm  NewTerm */
        wm_layer {
            display-name = "WM";
            bindings = <
/* Num  L */  &trans           &trans           &trans           &trans           &trans           &trans
/* Num  R */  &trans           &trans           &trans           &trans           &trans           &trans
/* Top  L */  &trans           &trans           &trans           &trans           &trans           &trans
/* Top  R */  &trans           &trans           &trans           &trans           &trans           &trans
/* Home L */  &trans           &kp RC(UP)       &kp LG(GRAVE)    &kp LC(LEFT)     &kp RC(RIGHT)    &trans
/* Home R */  &trans           &kp LS(LG(LBKT)) &kp LS(LG(RBKT)) &kp LC(GRAVE)    &kp LC(LS(GRAVE)) &trans
/* Bot  L */  &trans           &trans           &trans           &trans           &trans           &trans
/* Bot  R */  &trans           &trans           &trans           &trans           &trans           &trans
/* Innr L */  &trans           &trans           &trans           &trans           &trans
/* Innr R */  &trans           &trans           &trans           &trans           &trans
/* ThmA  L|R */  &trans                &trans                &trans                  &trans                &trans                &trans
/* ThmB  L|R */  &trans                &trans                &trans                  &trans                &trans                &trans
            >;
        };
    };
};

/* ── Trackball behavior (matches the wired/QMK setup) ──────────────────
 * LEFT (central) trackball  → scrolling
 * RIGHT (peripheral) trackball → cursor tracking (default; left unconfigured)
 *
 * This block modifies the existing central-trackball input listener so the
 * left ball emits scroll events instead of cursor movement. Tunables:
 *   - &zip_xy_scaler 1 3   : speed = multiply by 1, divide by 3. Raise the
 *                            divisor to scroll slower, lower it to scroll faster.
 *   - &zip_xy_to_scroll_mapper : converts pointer motion into scroll events.
 *   - INPUT_TRANSFORM_Y_INVERT : natural scrolling (content follows the top of
 *                            the ball). Remove it for standard scroll direction.
 */
&trackball_central_listener {
    input-processors =
        <&zip_xy_scaler 1 3>,
        <&zip_xy_to_scroll_mapper>,
        <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
};
